{
  "units":
  {
    "mesh": "millimeter"
  },

  "geometry":
  {
    "import_mesh": true,
    "mesh_format": "abaqus",
    "mesh_file": "mesh.inp",
    "dim": 3,
    "reset_material_id": true,
    "material_deposition": true,
    "material_deposition_method": "scan_paths",
