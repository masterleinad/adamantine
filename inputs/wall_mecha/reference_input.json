  "physics":
  {
    "thermal": true,
    "mechanical": false
  },

  "boundary":
  {
    "type": "radiative,convective,traction_free",
    "boundary_0":
    {
      "type": "radiative,convective,clamped"
    }
  },

  "refinement":
  {
    "n_refinements": 0,
    "time_steps_between_refinement": 10000000
  },

  "materials":
  {
    "n_materials": 1,
    "property_format": "polynomial",
    "material_0":
    {
      "initial_temperature": 300,
      "new_material_temperature": 300,
      "solid":
      {
        "specific_heat": 500.09,
        "density": "7990",
        "thermal_conductivity_x": "40",
        "thermal_conductivity_y": "40",
        "thermal_conductivity_z": "40",
        "emissivity": 0.25,
        "convection_heat_transfer_coef": 50,
        "lame_first_parameter": "113e9",
        "lame_second_parameter": "75.4e9",
        "thermal_expansion_coef": "1.51e-6",
        "plastic_modulus": "21e9",
        "isotropic_hardening": 1.0,
        "elastic_limit": "345e6"
      },
      "liquid":
      {
        "specific_heat": 500.09,
        "density": "7990",
        "thermal_conductivity_x": "25",
        "thermal_conductivity_y": "25",
        "thermal_conductivity_z": "25",
        "emissivity": 0.25,
        "convection_heat_transfer_coef": 22.631
      },
      "solidus": 1713,
      "liquidus": 1803,
      "latent_heat": 272000,
      "radiation_temperature_infty": 300,
      "convection_temperature_infty": 300
    }
  },

  "sources":
  {
    "n_beams": 1,
    "beam_0":
    {
      "type": "goldak",
      "depth": 2.31e-3,
      "diameter": 4.8e-3,
