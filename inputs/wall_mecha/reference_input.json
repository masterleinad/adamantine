{
  "units":
  {
    "mesh": "millimeter"
  },

  "geometry":
  {
    "import_mesh": true,
    "mesh_format": "abaqus",
    "mesh_file": "mesh.inp",
    "dim": 3,
    "reset_material_id": true,
    "material_deposition": true,
    "material_deposition_method": "scan_paths",
    "deposition_length": 4e-3,
    "deposition_height": 2.31e-3,
    "deposition_width": 13e-3,
    "deposition_time": 50,
    "deposition_lead_time": 1,
    "material_height": 0.0
  },

  "physics":
  {
    "thermal": true,
    "mechanical": false
  },

  "boundary":
  {
    "type": "convective,traction_free",
    "boundary_0":
    {
      "type": "convective,clamped"
    }
  },

  "refinement":
  {
    "n_refinements": 0,
    "time_steps_between_refinement": 10000000
  },

  "materials":
  {
    "n_materials": 1,
    "property_format": "polynomial",
    "material_0":
    {
      "initial_temperature": 300,
      "new_material_temperature": 300,
      "solid":
      {
        "specific_heat": 460.0,
        "density": "7990",
        "thermal_conductivity_x": "45",
        "thermal_conductivity_y": "45",
        "thermal_conductivity_z": "45",
        "convection_heat_transfer_coef": 24.1,
        "lame_first_parameter": "115e9",
        "lame_second_parameter": "80e9",
        "thermal_expansion_coef": "1.25e-5",
        "plastic_modulus": "20e9",
        "isotropic_hardening": 1.0,
        "elastic_limit": "335e6"
      },
      "liquid":
      {
        "specific_heat": 779.0,
        "density": "7990",
        "thermal_conductivity_x": "45",
        "thermal_conductivity_y": "45",
        "thermal_conductivity_z": "45",
        "convection_heat_transfer_coef": 24.1
      },
      "solidus": 1440,
      "liquidus": 1530,
      "latent_heat": 250000,
      "radiation_temperature_infty": 300,
      "convection_temperature_infty": 300
    }
  },

  "sources":
  {
    "n_beams": 1,
    "beam_0":
    {
      "type": "goldak",
      "depth": 3.5e-3,
      "diameter": 3.5e-3,
      "scan_path_file": "scan_path.inp",
      "scan_path_file_format": "event_series",
      "absorption_efficiency": 0.1763,
      "max_power": 1.0
    }
  },

  "time_stepping":
  {
    "method": "forward_euler",
    "scan_path_for_duration": true,
    "time_step": 1e-3
  },

  "post_processor":
  {
    "filename_prefix": "solution",
    "time_steps_between_output": 10000,
    "additional_output_refinement": 0
  },

  "discretization":
  {
    "thermal":
    {
      "fe_degree": 1,
      "quadrature": "gauss"
    }
  },

  "profiling":
  {
    "timer": false,
    "caliper": "loop-report,runtime-report(calc.inclusive,region.count,profile.kokkos)"
  },
  
  "memory_space": "host",
  "verbose_output": true
}
